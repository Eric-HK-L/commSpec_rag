# ==================== 3GPP RAG 融合项目 — 环境变量模板 ====================
#
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# -------------------- LLM 配置 --------------------
# 设计原则：所有后端统一走 OpenAI 兼容 API（/v1/chat/completions）
# base_url + api_key + model 三参数覆盖公司自建/公有云/Ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60.0

# 典型场景:
#   公司自建: LLM_BASE_URL=https://llm.internal.company.com/v1 LLM_MODEL=company-llm-v3
#   Ollama:   LLM_BASE_URL=http://localhost:11434/v1 LLM_API_KEY=ollama LLM_MODEL=qwen3:30b

# -------------------- 嵌入模型配置 --------------------
# 嵌入来源: "api" = 云端 API / "local" = 本地 BGE 模型
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=1024

# 云端嵌入模型 (EMBEDDING_PROVIDER=api 时使用)
EMBEDDING_MODEL=text-embedding-3-small

# 本地嵌入模型 (EMBEDDING_PROVIDER=local 时使用)
# BGE-M3: 多语言, 1024-dim, 同时输出稠密+稀疏向量, 支持 100+ 语言
# 支持 HF Hub 名称 (自动下载缓存) 或本地绝对路径 (离线/节省磁盘)
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# 嵌入计算设备: "auto"(自动) | "cuda" | "mps" | "cpu"
# auto=NVIDIA→cuda, Apple Silicon→cpu(安全, MPS有泄漏风险), 其他→cpu
# Apple Silicon 批量嵌入: 设 mps, 系统自动启用单进程 MPS 方案
EMBEDDING_DEVICE=auto

# -------------------- 向量数据库配置 (Milvus) --------------------
VECTOR_DB=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=TeleComm_specs

# -------------------- 文档摄入与分块 --------------------
INGESTION_SOURCE=from_scratch
DOCUMENTS_DIR=data/documents/R18
CHUNK_SIZE=512
CHUNK_OVERLAP=50
# ---- 数据根目录 ----
# 所有运行时数据（向量/清单/缓存/checkpoint）的统一根目录，默认 ./data/
# 如需外置存储，取消注释并改为绝对路径：
# DATA_DIR=/mnt/nas/3gpp-rag-data

# -------------------- 检索配置 --------------------
MAX_SEARCH_RESULTS=10
DENSE_TOP_K=100
BM25_TOP_K=100
SIMILARITY_THRESHOLD=0.7
ENABLE_NN_ROUTER=false

# -------------------- 在线搜索补充（可选） --------------------
ENABLE_ONLINE_SEARCH=false
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
TSPEC_LLM_URL=
ONLINE_SCORE_THRESHOLD=0.6

# -------------------- Cross-Encoder 精排（可选） --------------------
# 是否默认启用第二阶段 Cross-Encoder 精排 (前端可逐请求覆盖)
RERANKER_ENABLED=true
# reranker 模型: HuggingFace ID 或本地绝对路径
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 送入 reranker 的候选数 (混合检索 top-N)
RERANKER_TOP_K=100
# 推理设备: auto | mps | cuda | cpu
RERANKER_DEVICE=auto

# -------------------- API 服务配置 --------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# -------------------- 日志 --------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
