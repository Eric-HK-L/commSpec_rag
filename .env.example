# ==================== CommSpec RAG 融合项目 — 环境变量模板 ====================
#
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# -------------------- LLM 配置 --------------------
# 设计原则：所有后端统一走 OpenAI 兼容 API（/v1/chat/completions）
# base_url + api_key + model 三参数覆盖公司自建/公有云/Ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60.0

# 典型场景:
#   公司自建: LLM_BASE_URL=https://llm.internal.company.com/v1 LLM_MODEL=company-llm-v3
#   Ollama:   LLM_BASE_URL=http://localhost:11434/v1 LLM_API_KEY=ollama LLM_MODEL=qwen3:30b

# -------------------- 嵌入模型配置 --------------------
# 嵌入来源: "api" = 云端 API / "local" = 本地 BGE 模型
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=1024

# 云端嵌入模型 (EMBEDDING_PROVIDER=api 时使用)
EMBEDDING_MODEL=text-embedding-3-small

# 本地嵌入模型 (EMBEDDING_PROVIDER=local 时使用)
# BGE-M3: 多语言, 1024-dim, 同时输出稠密+稀疏向量, 支持 100+ 语言
# 支持 HF Hub 名称 (自动下载缓存) 或本地绝对路径 (离线/节省磁盘)
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# 嵌入计算设备: "auto"(自动) | "cuda" | "mps" | "cpu"
# auto=NVIDIA→cuda, Apple Silicon→cpu(安全, MPS有泄漏风险), 其他→cpu
# Apple Silicon 批量嵌入: 设 mps, 系统自动启用单进程 MPS 方案
EMBEDDING_DEVICE=auto

# -------------------- 向量数据库配置 (Milvus) --------------------
VECTOR_DB=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=TeleComm_specs

# -------------------- 文档摄入与分块 --------------------
# 摄入模式: "from_scratch" | "resume"
INGESTION_SOURCE=from_scratch
DOCUMENTS_DIR=data/documents
# ---- IngestionConfig (INGESTION__ 前缀) ----
# 分块模式: "fixed" | "dynamic"
INGESTION__CHUNK_MODE=dynamic
INGESTION__CHUNK_SIZE=1024
INGESTION__CHUNK_OVERLAP=100
# dynamic 模式下表格/正文各自上限
INGESTION__TABLE_MAX_CHARS=5000
INGESTION__PROSE_MAX_CHARS=1500
# BGE-M3 8192 token 安全上限 (汉字/ASN.1 密集场景留 ~15% 边距)
INGESTION__MAX_CHUNK_CHARS=8000
# 嵌入批大小
INGESTION__BATCH_SIZE=64
# ---- 数据根目录 ----
# 所有运行时数据（向量/清单/缓存/checkpoint）的统一根目录，默认 ./data/
# 如需外置存储，取消注释并改为绝对路径：
# DATA_DIR=/mnt/nas/commspec-rag-data

# -------------------- 检索配置 --------------------
MAX_SEARCH_RESULTS=10
DENSE_TOP_K=100
BM25_TOP_K=100
SIMILARITY_THRESHOLD=0.7
ENABLE_NN_ROUTER=false

# ---- RAG 检索调优 (改动建议用 tests/eval 评测集回归验证) ----
# RRF 融合 Dense/BM25 的 k 值: k 越小该路排名贡献越大
# 3GPP 场景 Dense 通常优于 BM25, 可尝试 RRF_K_DENSE=40 / RRF_K_SPARSE=120
RRF_K_DENSE=60
RRF_K_SPARSE=60
# 查询扩展 (false = 直接用原始查询检索, 省一次 LLM 调用)
QUERY_EXPANSION_ENABLED=true
# 多跳检索预算: 控制 LLM 缺口分析轮次与每轮子查询数
MULTI_HOP_MAX_ROUNDS=2
MULTI_HOP_MAX_SUB_QUERIES=3

# -------------------- 在线搜索补充（可选） --------------------
ENABLE_ONLINE_SEARCH=false
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
TSPEC_LLM_URL=
ONLINE_SCORE_THRESHOLD=0.6

# -------------------- Cross-Encoder 精排（可选） --------------------
# 是否默认启用第二阶段 Cross-Encoder 精排 (前端可逐请求覆盖)
RERANKER_ENABLED=true
# reranker 模型: HuggingFace ID 或本地绝对路径
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 送入 reranker 的候选数 (混合检索 top-N)
RERANKER_TOP_K=100
# 推理设备: auto | mps | cuda | cpu
RERANKER_DEVICE=auto

# -------------------- API 服务配置 --------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# -------------------- 安全与认证 --------------------
# 管理后台登录 (为空时登录接口禁用, 管理端点返回 401/403)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# 会话签名密钥 (多 worker / 多实例部署必须显式配置为强随机值, 否则重启后会话失效)
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12

# API Key 认证 (逗号分隔; 为空时所有 API 端点免认证, 生产环境务必配置)
API_KEYS=

# CORS 白名单 (JSON 数组; 为空时仅同源/反向代理访问)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 速率限制 (按 IP, 针对 /ask /search 等 LLM 端点)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPM=60

# -------------------- 日志 --------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
